+#ifdef CUSTOM_SY
+// ── Wireless firmware update ─────────────────────────────────────────────
+// Multipart upload of firmware.bin into the idle OTA slot (default_16MB.csv
+// has app0/app1); the boot slot switches only after the whole image verifies,
+// so a dropped upload leaves the running firmware untouched. Auth = a PIN
+// login session + an X-OTA header (a cross-site form can set neither the
+// SameSite=Strict cookie nor custom headers). The chip id in the image header
+// must be ESP32-S3 so a build for another board can't be installed by mistake.
+static bool   s_otaActive = false;
+static bool   s_otaOk     = false;
+static size_t s_otaBytes  = 0;
+static char   s_otaErr[40] = "";
+
+static void otaFail(const char* why) {
+    if (s_otaActive) Update.abort();
+    s_otaActive = false;
+    if (!s_otaErr[0]) strlcpy(s_otaErr, why, sizeof(s_otaErr));
+}
+
+static void handleOtaUpload() {
+    HTTPUpload& up = s_server.upload();
+    switch (up.status) {
+        case UPLOAD_FILE_START:
+            s_otaOk = false;
+            s_otaActive = false;
+            s_otaBytes = 0;
+            s_otaErr[0] = '\0';
+            if (!findSession() || s_server.header("X-OTA") != "1") {
+                strlcpy(s_otaErr, "auth", sizeof(s_otaErr));
+                return;
+            }
+            if (!Update.begin(UPDATE_SIZE_UNKNOWN, U_FLASH)) {
+                snprintf(s_otaErr, sizeof(s_otaErr), "begin_failed_%u", (unsigned)Update.getError());
+                return;
+            }
+            s_otaActive = true;
+            break;
+        case UPLOAD_FILE_WRITE:
+            if (!s_otaActive) return;
+            if (s_otaBytes == 0) {
+                // esp_image_header_t: magic 0xE9 at 0, chip_id (u16 LE) at 12.
+                uint16_t chip = up.currentSize >= 14 ? (up.buf[12] | (up.buf[13] << 8)) : 0xFFFF;
+                if (up.currentSize < 14 || up.buf[0] != 0xE9 || chip != 9 /* ESP32-S3 */) {
+                    otaFail("not_esp32s3_image");
+                    return;
+                }
+            }
+            if (Update.write(up.buf, up.currentSize) != up.currentSize) {
+                snprintf(s_otaErr, sizeof(s_otaErr), "write_failed_%u", (unsigned)Update.getError());
+                otaFail("write_failed");
+                return;
+            }
+            s_otaBytes += up.currentSize;
+            break;
+        case UPLOAD_FILE_END:
+            if (!s_otaActive) return;
+            s_otaActive = false;
+            if (s_otaBytes > 0 && Update.end(true)) {
+                s_otaOk = true;
+            } else {
+                snprintf(s_otaErr, sizeof(s_otaErr), "verify_failed_%u", (unsigned)Update.getError());
+            }
+            break;
+        case UPLOAD_FILE_ABORTED:
+            otaFail("aborted");
+            break;
+        default:
+            break;
+    }
+}
+
+static void handleOtaDone() {
+    if (!s_otaOk) {
+        bool auth = strcmp(s_otaErr, "auth") == 0;
+        sendErr(auth ? 401 : 400, s_otaErr[0] ? s_otaErr : "no_file");
+        return;
+    }
+    s_otaOk = false;
+    s_actions |= PANEL_ACT_REBOOT;
+    s_notBeforeMs = millis() + 800;   // let the response flush first
+    JsonDocument d;
+    d["ok"]        = true;
+    d["bytes"]     = (uint32_t)s_otaBytes;
+    d["rebooting"] = true;
+    sendJson(200, d);
+}
+#endif // CUSTOM_SY
