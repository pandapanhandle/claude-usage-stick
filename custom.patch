+// ── Custom build (CUSTOM_SY) ─────────────────────────────
+// Passphrase for the device-bound auto-unlock copy of the token. The real key
+// also mixes in the chip's MAC (crypto.cpp salt), so the copy only decrypts on
+// this board. This is convenience, not secrecy: anyone holding the board can
+// recover the token, which is the trade the owner chose for PIN-free boots.
+#define AUTO_UNLOCK_PASS        "custom-sy/auto-unlock/v1"
+#define STALE_GRACE_SEC         90       // stale once older than 2 polls + this
+#define USAGE_CACHE_MAX_AGE_S   (15 * 60)  // rewrite the cache at least this often while values hold
+#define WARN_PCT                75.0f    // bars turn amber
+#define CRIT_PCT                90.0f    // bars turn red
+
 // ── Feature flags (set via build_flags in platformio.ini) ────
 // MANGO_UI — the "Mango" dashboard: model-status mascots from status.claude.com,
