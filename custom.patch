+/* ── wireless firmware update (custom build) ── */
+$('btnOta').onclick = () => {
+  const f = $('otaFile').files[0];
+  if (!f) return toast('otaStatus', 'Choose a firmware .bin file first.');
+  if (!/\.bin$/i.test(f.name)) return toast('otaStatus', 'That isn\'t a .bin file.');
+  const fd = new FormData();
+  fd.append('fw', f, f.name);
+  const x = new XMLHttpRequest();
+  x.open('POST', '/api/ota');
+  x.setRequestHeader('X-OTA', '1');   // a cross-site form can't set this
+  const pr = $('otaProg');
+  pr.hidden = false; pr.value = 0;
+  $('btnOta').disabled = true;
+  $('otaStatus').className = 'status';
+  $('otaStatus').textContent = 'Uploading...';
+  x.upload.onprogress = e => {
+    if (e.lengthComputable) pr.value = e.loaded * 100 / e.total;
+    if (e.loaded === e.total) $('otaStatus').textContent = 'Installing...';
+  };
+  x.onload = () => {
+    $('btnOta').disabled = false;
+    if (x.status === 200) {
+      pr.value = 100;
+      $('otaStatus').className = 'status okc';
+      $('otaStatus').textContent = 'Done. Rebooting \u2014 this page reloads in about 30 seconds.';
+      setTimeout(() => location.reload(), 30000);
+      return;
+    }
+    pr.hidden = true;
+    let why = '';
+    try { why = JSON.parse(x.responseText).error; } catch (e) {}
+    if (x.status === 401) { showLogin(); return; }
+    const msg = why === 'not_esp32s3_image' ? 'That file isn\'t firmware for this board.' : 'Update failed' + (why ? ': ' + why : '.');
+    toast('otaStatus', msg);
+  };
+  x.onerror = () => {
+    $('btnOta').disabled = false;
+    pr.hidden = true;
+    toast('otaStatus', 'Upload failed \u2014 connection lost.');
+  };
+  x.send(fd);
+};
