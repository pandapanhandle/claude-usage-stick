@@ -0,0 +1,37 @@
+#pragma once
+// Custom build (CUSTOM_SY): PIN-free boot, cached usage for instant wake-up,
+// and the stale-data bookkeeping the dashboard reads.
+//
+// The PIN still guards the web panel and token changes; only the boot screen's
+// PIN prompt goes away. To do that the token is kept a second time, encrypted
+// with a key bound to this chip (AUTO_UNLOCK_PASS + MAC salt) instead of the PIN.
+#include <stdint.h>
+#include <stddef.h>
+#include "api.h"
+
+#ifdef CUSTOM_SY
+
+// Decrypts the device-bound copy into tokOut. False when there is none yet
+// (first boot after flashing) or it no longer decrypts.
+bool customAutoUnlockLoad(char* tokOut, size_t tokMax);
+
+// Saves the device-bound copy of a token that was just proven with the PIN.
+// Skips the flash write when the stored copy already holds this token.
+void customAutoUnlockRemember(const char* token);
+
+// Last good reading, persisted so a cold boot can show numbers at once.
+struct UsageCache {
+    uint32_t magic;
+    float    h5, d7;
+    uint32_t h5ResetEpoch, d7ResetEpoch;
+    uint32_t fetchedEpoch;   // wall-clock time the numbers were fetched
+};
+
+bool customCacheLoad(UsageData& out, uint32_t& fetchedEpoch);
+// Rate-limited: writes only when the numbers moved or the copy is old.
+void customCacheSave(const UsageData& u, uint32_t fetchedEpoch);
+
+// True once NTP has set a plausible wall clock.
+bool customTimeValid();
+
+#endif
