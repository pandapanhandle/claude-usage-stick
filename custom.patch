diff --git a/src/custom.cpp b/src/custom.cpp
new file mode 100644
index 0000000..94ffc64
--- /dev/null
+++ b/src/custom.cpp
@@ -0,0 +1,76 @@
+#include "custom.h"
+
+#ifdef CUSTOM_SY
+
+#include <Arduino.h>
+#include <string.h>
+#include <time.h>
+#include <math.h>
+#include "config.h"
+#include "crypto.h"
+#include "settings.h"
+
+static const char*    KEY_AUTO    = "ablob";
+static const char*    KEY_CACHE   = "ucache";
+static const uint32_t CACHE_MAGIC = 0x55434331;   // "UCC1"
+
+// The token the stored auto-unlock copy currently holds (RAM only), so repeat
+// panel logins don't rewrite flash.
+static char s_rememberedTok[256] = "";
+
+bool customAutoUnlockLoad(char* tokOut, size_t tokMax) {
+    EncryptedBlob b;
+    if (settingsGetBlob(KEY_AUTO, &b, sizeof(b)) != sizeof(b)) return false;
+    if (!decryptToken(b, AUTO_UNLOCK_PASS, tokOut, tokMax)) return false;
+    strlcpy(s_rememberedTok, tokOut, sizeof(s_rememberedTok));
+    return true;
+}
+
+void customAutoUnlockRemember(const char* token) {
+    if (!token || !token[0]) return;
+    if (strcmp(token, s_rememberedTok) == 0) return;
+    EncryptedBlob b;
+    if (!encryptToken(token, AUTO_UNLOCK_PASS, b)) return;
+    settingsPutBlob(KEY_AUTO, &b, sizeof(b));
+    strlcpy(s_rememberedTok, token, sizeof(s_rememberedTok));
+    memset(&b, 0, sizeof(b));
+}
+
+bool customTimeValid() {
+    return time(nullptr) > 1700000000;   // Nov 2023 — anything earlier is an unsynced clock
+}
+
+bool customCacheLoad(UsageData& out, uint32_t& fetchedEpoch) {
+    UsageCache c;
+    if (settingsGetBlob(KEY_CACHE, &c, sizeof(c)) != sizeof(c)) return false;
+    if (c.magic != CACHE_MAGIC || c.fetchedEpoch < 1700000000) return false;
+    memset(&out, 0, sizeof(out));
+    out.h5 = c.h5;
+    out.d7 = c.d7;
+    out.h5ResetEpoch = c.h5ResetEpoch;
+    out.d7ResetEpoch = c.d7ResetEpoch;
+    out.ok = true;
+    fetchedEpoch = c.fetchedEpoch;
+    return true;
+}
+
+void customCacheSave(const UsageData& u, uint32_t fetchedEpoch) {
+    if (!u.ok || fetchedEpoch < 1700000000) return;
+    static UsageCache last = {};
+    bool moved = lroundf(u.h5) != lroundf(last.h5) || lroundf(u.d7) != lroundf(last.d7) ||
+                 u.h5ResetEpoch != last.h5ResetEpoch || u.d7ResetEpoch != last.d7ResetEpoch;
+    bool old = fetchedEpoch - last.fetchedEpoch >= USAGE_CACHE_MAX_AGE_S;
+    if (last.magic == CACHE_MAGIC && !moved && !old) return;
+
+    UsageCache c;
+    c.magic = CACHE_MAGIC;
+    c.h5 = u.h5;
+    c.d7 = u.d7;
+    c.h5ResetEpoch = u.h5ResetEpoch;
+    c.d7ResetEpoch = u.d7ResetEpoch;
+    c.fetchedEpoch = fetchedEpoch;
+    settingsPutBlob(KEY_CACHE, &c, sizeof(c));
+    last = c;
+}
+
+#endif // CUSTOM_SY
diff --git a/src/custom.h b/src/custom.h
new file mode 100644
